  "info": {
    "title": "Oficina Production Service",
    "description": "",
    "version": "4.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internal-token": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token"
      }
    },
    "schemas": {
      "AssignDto": {
        "type": "object",
        "properties": {
          "mecanicoId": {
            "type": "string"
          }
        },
        "required": [
          "mecanicoId"
        ]
      },
      "DiagnosisDto": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          }
        },
        "required": [
          "descricao"
        ]
      },
      "ConsumeDto": {
        "type": "object",
        "properties": {
          "pecaId": {
            "type": "string"
          },
          "quantidade": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "pecaId",
          "quantidade"
        ]
      },
      "StockDto": {
        "type": "object",
        "properties": {
          "filialId": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 0,
            "description": "Quantidade disponível, excluindo reservas existentes"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "filialId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "osId": {
            "type": "string"
          },
          "filialId": {
            "type": "string"
          },
          "clienteId": {
            "type": "string"
          },
          "mecanicoId": {
            "type": "string"
          }
        },
        "required": [
          "osId",
          "filialId",
          "clienteId"
        ]
      },
      "CreatePieceDto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "precoVenda": {
            "type": "number"
          },
          "descricao": {
            "type": "string"
          },
          "filialId": {
            "type": "string"
          },
          "quantidadeInicial": {
            "type": "number"
          },
          "quantidadeMinima": {
            "type": "number"
          }
        },
        "required": [
          "codigo",
          "nome",
          "precoVenda"
        ]
      },
      "UpdatePieceDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "precoVenda": {
            "type": "number"
          },
          "descricao": {
            "type": "object"
          },
          "quantidadeMinima": {
            "type": "number"
          }
        }
      },
      "EntryDto": {
        "type": "object",
        "properties": {
          "quantidade": {
            "type": "number"
          }
        },
        "required": [
          "quantidade"
        ]
      }
    }
  }
